# Configuración del servidor
PORT=4000
NODE_ENV=development

# Base de datos MongoDB
MONGODB_URI=completar

# JWT Secret Key para autenticación
JWT_SECRET_KEY=completar

# Configuración de Email (opcional - para recuperación de contraseña)
# IMPORTANTE: Gmail requiere una contraseña de aplicación, NO la contraseña normal.
# Generala en https://myaccount.google.com/apppasswords y copia el valor real aquí.
# Si usas otro proveedor SMTP, seteá EMAIL_HOST, EMAIL_PORT, EMAIL_SECURE y EMAIL_PROVIDER.
EMAIL_PROVIDER=gmail
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=laviejaestacionbar@gmail.com
EMAIL_PASS=completar
EMAIL_FROM=laviejaestacionbar@gmail.com
EMAIL_RESTOBAR=laviejaestacionbar@gmail.com

# URL del frontend (para enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# URL del backend (para enlaces de confirmación de reservas)
BASE_URL=http://localhost:4000

# CORS Origins permitidos
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=completar

NODE_ENV=development
MAIL_OVERRIDE_TO=laviejaestacionbar@gmail.com
TEST_RESET_PASSWORD=Restobar26

TEST_RESET_EMAIL=ferreyra@restobar.com
MAIL_OVERRIDE_TO=laviejaestacionbar@gmail.com
TEST_RESET_PASSWORD=Restobar26
